# Create credentials at https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Choose a strong password for the dashboard login.
APP_PASSWORD=replace_with_a_long_unique_password

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_64_character_hex_value

# Optional. The secure defaults expose the app only on this computer.
PORT=3000
HOST=127.0.0.1
